# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/unifind
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unifind?retryWrites=true&w=majority

# Client URL (For strict CORS, leave * for all)
CLIENT_URL=*
